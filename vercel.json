{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api" },
    { "source": "/cron/(.*)", "destination": "/api" },
    { "source": "/healthz(.*)", "destination": "/api" },
    { "source": "/((?!assets/|favicon\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "dist/**" }
  },
  "crons": [{ "path": "/cron/tick", "schedule": "10 2 * * *" }]
}
