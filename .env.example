# Postgres connection for the studio's Supabase project (ideation schema lives here)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Claude — the only paid line item
ANTHROPIC_API_KEY=
# Model tiering (spec: Haiku-class for extraction/tagging/verdicts/adapters, Sonnet-class for strategy/ideation/reports)
MODEL_FAST=claude-haiku-4-5
MODEL_STRATEGY=claude-sonnet-5
# Per-workspace daily Claude budget in USD (cost guardrail)
WORKSPACE_DAILY_BUDGET_USD=1.00

# The one new key: YouTube Data API
YOUTUBE_API_KEY=

# Wikimedia asks every client to identify itself
HTTP_USER_AGENT=ContentIdeationEngine/0.1 (contact@example.com)

# Brief handoff: optional signed webhook to the studio (queue table is always written)
STUDIO_WEBHOOK_URL=
STUDIO_WEBHOOK_SECRET=

# Shared secret the studio sends as Bearer token to this API
API_TOKEN=
PORT=8787

# The studio exposes fresh OAuth tokens for its connected accounts (tokens never leave the studio's store)
STUDIO_TOKEN_URL=
STUDIO_API_TOKEN=
# API versions (bump when the playbook review happens)
META_GRAPH_VERSION=v23.0
LINKEDIN_VERSION=202509

# Embeddings: the Supabase Edge Function in supabase/functions/embed (built-in gte-small, 384 dims, free).
# Unset = lexical similarity fallback for white-space scoring and de-duplication.
EMBED_URL=
EMBED_API_KEY=

# Serverless (Vercel): the cron route /cron/tick requires `Authorization: Bearer CRON_SECRET`
# (Vercel Cron sends it automatically when CRON_SECRET is set). Keep the pool small per function.
CRON_SECRET=
DB_POOL_MAX=10

# TEMPORARY until user sign-in exists: "open" lets the web app call /v1 without a token.
# Anyone with the URL can then read and change data. Use "token" for studio-only access.
AUTH_MODE=token
